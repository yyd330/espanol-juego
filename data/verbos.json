  "mixto": {
    "tense": "pretérito vs imperfecto",
    "lesson": "Pretérito = completed action ('did it, once, done'). Imperfecto = in progress, habitual, or background ('was doing, used to, happened often'). In one story: the imperfecto paints the scene, the pretérito makes it happen. 'Yo ___ (estar) cansado cuando ___ (sonar) el teléfono.'",
    "verbs": [
      {"person": "yo", "level": "b1", "answer": "estaba", "sentence": "Yo ___ cansado cuando sonó el teléfono.", "clue": "estado en progreso (in progress) → imperfect of estar"},
      {"person": "yo", "level": "b1", "answer": "llegué", "sentence": "___ a casa a las 8 y cené con mi familia.", "clue": "acción completa (completed action) → preterite of llegar"},
      {"person": "ella", "level": "b1", "answer": "comía", "sentence": "Ella ___ cuando el teléfono sonó.", "clue": "incomplete action interrupted → imperfect of comer"},
      {"person": "tú", "level": "b1", "answer": "encontraste", "sentence": "¿___ tu llave en el bolso?", "clue": "completed, one-time action → preterite of encontrar"},
      {"person": "nosotros", "level": "b1", "answer": "vivíamos", "sentence": "Nosotros ___ en Monterrey diez años.", "clue": "ongoing past state → imperfect of vivir"},
      {"person": "él", "level": "b1", "answer": "leía", "sentence": "Él ___ el periódico mientras ___ (tomar) el café.", "clue": "ongoing simultaneous action → imperfect of leer"},
      {"person": "ella", "level": "b2", "answer": "terminó", "sentence": "Ella ___ de cenar y puso la mesa.", "clue": "second completed action in a chain → preterite of terminar"},
      {"person": "yo", "level": "b2", "answer": "soñaba", "sentence": "Yo ___ con los tacos cuando desperté.", "clue": "ongoing when interrupted → imperfect of soñar"},
      {"person": "tú", "level": "b2", "answer": "perdiste", "sentence": "¿___ el tren por cinco minutos?", "clue": "one-time completed event → preterite of perder"},
      {"person": "nosotros", "level": "b2", "answer": "hacía", "sentence": "Cuando ___ (hacer) frío, nosotros ___ (poner) la estufa.", "clue": "habitual condition in the past → imperfect of hacer"}
    ]
  },
